<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>15.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <CopelandRoot Condition="'$(CopelandRoot)' == ''">$(MSBuildThisFileDirectory)../Copeland</CopelandRoot>
    <InputManRoot Condition="'$(InputManRoot)' == ''">$(MSBuildThisFileDirectory)../InputMan</InputManRoot>
    <DeliveranceRoot Condition="'$(DeliveranceRoot)' == ''">$(MSBuildThisFileDirectory)../Deliverance</DeliveranceRoot>
  </PropertyGroup>
</Project>
