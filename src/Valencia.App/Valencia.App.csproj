<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/dependencies.json" Link="docs/dependencies.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <ProjectReference Include="../Valencia.Core/Valencia.Core.csproj" />
    <ProjectReference Include="../Valencia.Media/Valencia.Media.csproj" />
    <ProjectReference Include="../Valencia.Rendering/Valencia.Rendering.csproj" />
    <ProjectReference Include="../Valencia.Scripting/Valencia.Scripting.csproj" />
    <ProjectReference Include="../Valencia.Persistence/Valencia.Persistence.csproj" />
    <ProjectReference Include="$(InputManRoot)/src/InputMan.Core/InputMan.Core.csproj" />
  </ItemGroup>
</Project>
